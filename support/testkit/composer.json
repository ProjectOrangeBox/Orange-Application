{
    "name": "orange/testkit",
    "description": "Shared PHPUnit base helper (unitTestHelper) for orange/* package test suites.",
    "type": "library",
    "homepage": "https://github.com/ProjectOrangeBox/testkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Don Myers",
            "email": "donmyers@me.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ProjectOrangeBox/testkit/issues",
        "source": "https://github.com/ProjectOrangeBox/testkit"
    },
    "require": {
        "php": ">=8.4",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
