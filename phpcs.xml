<?xml version="1.0"?>
<ruleset name="webapp">
    <description>Coding standard for the webapp application code.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="np"/>

    <file>application</file>
    <file>config</file>
    <file>bin</file>
    <file>database</file>
    <file>phinx.php</file>
    <file>htdocs</file>

    <!-- generated by the detectors; regenerating overwrites any fix applied here -->
    <exclude-pattern>config/production/*</exclude-pattern>

    <!-- Phinx loads migrations and seeders by mapping the filename to a class
         name in the global namespace, so they cannot be namespaced without
         reconfiguring how phinx finds them. PSR-12 wants a namespace; phinx
         wants none, and phinx is the one that has to run them. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>database/migrations/*</exclude-pattern>
        <exclude-pattern>database/seeds/*</exclude-pattern>
    </rule>

    <rule ref="PSR12">
        <!-- Drop PSR-12 §2.3's 120-character soft line-length limit; every other
             PSR-12 sniff still applies. -->
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>
</ruleset>
