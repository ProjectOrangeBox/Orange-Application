{
    "name": "orange/orange-framework",
    "authors": [
        {
            "name": "Don Myers",
            "email": "donmyers@me.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "application\\": "application"
        },
        "files": [],
        "classmap": []
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "phpunit/php-code-coverage": "^14.2",
        "squizlabs/php_codesniffer": "3.*",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.0",
        "orange/testkit": "dev-master"
    },
    "require": {
        "robmorgan/phinx": "^0.16",
        "brick/varexporter": "0.*",
        "orange/framework": "dev-master",
        "orange/bitwise": "dev-master",
        "orange/acl": "dev-master",
        "orange/asset": "dev-master",
        "orange/auth": "dev-master",
        "orange/benchmark": "dev-master",
        "orange/cache": "dev-master",
        "orange/collector": "dev-master",
        "orange/console": "dev-master",
        "orange/cookies": "dev-master",
        "orange/disc": "dev-master",
        "orange/fig": "dev-master",
        "orange/files": "dev-master",
        "orange/flashmsg": "dev-master",
        "orange/handlebars": "dev-master",
        "orange/language": "dev-master",
        "orange/mergeview": "dev-master",
        "orange/model": "dev-master",
        "orange/negotiate": "dev-master",
        "orange/observer": "dev-master",
        "orange/priority": "dev-master",
        "orange/dto": "dev-master",
        "orange/session": "dev-master",
        "orange/snippets": "dev-master",
        "orange/stash": "dev-master",
        "orange/markdown": "dev-master",
        "symfony/mailer": "^8.1"
    },
    "scripts": {
        "build:production": [
            "@php bin/detectExport",
            "@php bin/configExport"
        ],
        "config:export": "@php bin/configExport",
        "types:export": "@php bin/dtoExport",
        "types:check": "@php bin/dtoExport --check",
        "types:publish": "@php bin/dtoExport --publish",
        "lock:check": "@php bin/lockCheck",
        "db:migrate": "@php vendor/bin/phinx migrate",
        "db:seed": "@php vendor/bin/phinx seed:run",
        "db:export": "@php bin/dbExport",
        "db:check": "@php bin/dbExport --check",
        "test": "cd unittest && sh runUnitTests.sh",
        "test:orange": "cd vendor/orange/framework/unittest && sh runUnitTests.sh",
        "test:orangeCoverage": "cd vendor/orange/framework/unittest && sh runCoverage.sh",
        "type-check": "phpstan analyse",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "rector": "rector --dry-run",
        "rector:fix": "rector"
    },
    "scripts-descriptions": {
        "test:orange": "Run the Orange Framework core unit tests.",
        "test:orangeCoverage": "Run the Orange Framework core unit tests with code coverage.",
        "type-check": "Run PHPStan static type analysis on the application code.",
        "lint": "Check the application code against the PSR-12 coding standard.",
        "lint:fix": "Auto-fix PSR-12 coding standard violations where possible.",
        "rector": "Preview Rector automated refactorings (dry-run, writes nothing).",
        "rector:fix": "Apply Rector automated refactorings to the application code."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://projectorangebox.github.io/OrangePackages/"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {}
}
