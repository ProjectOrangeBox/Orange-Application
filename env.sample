; ###########################################################################
; IMPORTANT: the generated .env must contain NO comment lines.
;
; Two parsers read .env and they disagree about comments:
;   - PHP's parse_ini_file() wants ";" and chokes on "#"
;   - Docker Compose auto-loads .env, wants "#", and chokes on ";"
; There is no comment style both accept, so .env carries values only and all
; documentation lives here instead. docker-entrypoint.sh strips these comment
; lines when it seeds .env from this file. If you add options to .env by hand,
; add them without comments.
; ###########################################################################

; ---------------------------------------------------------------------------
; Application environment
; ---------------------------------------------------------------------------
; Selects the config cascade (config/{ENVIRONMENT}/), and how the container
; caches. docker-entrypoint.sh reads this at startup, so a change only takes
; effect on container restart:
;
;   production -> opcache stops checking file timestamps and dev dependencies
;                 are skipped. Code is cached for the life of the container, so
;                 edits are NOT picked up until you restart it - which is also
;                 how you deploy.
;
;   anything   -> opcache revalidates on every request, so edits show up
;   else          immediately on reload, and dev dependencies are installed.
;
; Every request is served by a fresh PHP process either way.
;
; Left unset this defaults to production, matching the framework's own default.
ENVIRONMENT=development
DEBUG=true

; ---------------------------------------------------------------------------
; Container / web server options (read by docker-entrypoint.sh on startup)
; ---------------------------------------------------------------------------
; These must stay above the first [section] header - the entrypoint only reads
; top-level keys, so anything below a section header is invisible to it.

; Hostname Caddy binds to, and the name on the TLS certificate.
;   localhost     -> HTTPS with a local self-signed cert (browser warning)
;   :80           -> plain HTTP only, no TLS at all
;   www.site.com  -> automatic Let's Encrypt certificate (production)
; The container listens on 80/443; docker-compose.yml maps those to 8080/8443.
SERVER_NAME=localhost

; ---------------------------------------------------------------------------
; Database
; ---------------------------------------------------------------------------
[db]
; use host.docker.internal when the app runs in its container,
; 127.0.0.1 when running on the host
host = 'host.docker.internal'
port = 3306
database = webapp
username = webapp
password = webapp_password
charset = utf8mb4

; Session cookie Secure flag. Left unset it follows ENVIRONMENT: on in
; production, off in development - because the quick start serves
; http://localhost:8080 and a browser silently drops a Secure cookie sent over
; plaintext, which means no session ever persists and a login appears to do
; nothing. Set it to true if you serve development over TLS.
;SESSION_COOKIE_SECURE=false

; ---------------------------------------------------------------------------
; Mail
; ---------------------------------------------------------------------------
; Read by config/services.php and handed to orange\mail\Mailer. Full
; documentation of every option is in vendor/orange/mail/README.md.
[mail]
; A symfony/mailer transport DSN. There is no default: a mailer pointed nowhere
; silently discards every message, so an unset dsn is a startup error rather
; than mail that appears to work.
;
;   smtp://host.docker.internal:1025   the mail sandbox, from inside this container
;   smtp://127.0.0.1:1025              the same sandbox, from the host or a CLI script
;   smtp://user:pass@host:587          a real relay
;   sendmail://default                 the local sendmail binary
;   null://null                        accepted and discarded, sending nothing anywhere
;
; The sandbox is a separate repo holding one docker-compose.yml, like the mysql
; and cache containers - clone it beside this one and `docker compose up -d`.
dsn = 'smtp://host.docker.internal:1025'

; The return address on any message that does not name its own, and the display
; name shown beside it.
from = 'no-reply@example.test'
from_name = 'Orange Application'

; When set, EVERY recipient is replaced by this address and the real ones are
; kept in X-Orange-Original-To/Cc/Bcc headers. For a staging box holding a copy
; of live data, where the danger is not that mail fails but that it succeeds.
; Leave it empty here - the mail sandbox already delivers to nobody.
catch_all = ''

; Prefixed to every subject, e.g. '[staging] '. Applied after validation.
subject_prefix = ''
